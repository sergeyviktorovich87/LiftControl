[Unit]
Description=LiftControl panel update request broker
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=GH_CONFIG_DIR=/var/lib/liftcontrol-updater/gh
Environment=GH_PROMPT_DISABLED=1
ExecStart=/usr/bin/python3 /usr/local/lib/liftcontrol/github-update-bridge.py
TimeoutStartSec=infinity
Nice=10
